{
  "name": "svelte-reveal-monorepo",
  "private": true,
  "workspaces": [
    "examples/*",
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "pack": "turbo run pack",
    "format": "prettier . --write",
    "format:staged": "pretty-quick --staged",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prepare": "husky",
    "clean": "turbo run clean",
    "postclean": "rimraf .turbo node_modules package-lock.json"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "pretty-quick": "4.2.2",
    "rimraf": "6.1.3",
    "turbo": "2.9.6"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.7"
}
